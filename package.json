{
  "name": "intro-web",
  "version": "0.4.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @intro-builder/web dev",
    "build": "pnpm --filter @intro-builder/web build",
    "start": "pnpm --filter @intro-builder/web start",
    "lint": "pnpm --recursive lint",
