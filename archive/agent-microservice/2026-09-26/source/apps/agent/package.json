{
  "name": "@intro-builder/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.local --import tsx/esm --watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "eval:agent:offline": "tsx src/evals/run-agent-message-contract-eval.ts",
    "eval:agent:langfuse": "tsx src/evals/run-langfuse-agent-message-experiment.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.56",
    "@ag-ui/encoder": "0.0.56",
    "@ai-sdk/openai-compatible": "2.0.50",
    "@langfuse/client": "5.4.1",
    "@langfuse/otel": "5.4.1",
    "@langfuse/tracing": "5.4.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-node": "0.218.0",
    "ai": "6.0.204",
    "jose": "^6.2.3",
    "redis": "^6.0.0",
    "zod": "^4.4.3"
  }
}
