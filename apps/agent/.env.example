AGENT_HOST=0.0.0.0
AGENT_PORT=8787
AGENT_SERVICE_NAME=intro-agent
AGENT_VERSION=0.0.0-dev
AGENT_SHUTDOWN_TIMEOUT_MS=10000
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=1000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30

# Used by Caddy in compose.yaml. Set to the production Agent domain later.
AGENT_SITE_ADDRESS=api.rory-x.me
AGENT_PUBLIC_BASE_PATH=/intro-builder/agent

# Reserved for later phases. The foundation service does not read these yet.
# AGENT_JWT_SECRET=
