AGENT_HOST=0.0.0.0
AGENT_PORT=8787
AGENT_SERVICE_NAME=intro-agent
AGENT_VERSION=0.0.0-dev
AGENT_SHUTDOWN_TIMEOUT_MS=10000
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=1000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
AGENT_JWT_ISSUER=intro-builder-web
AGENT_JWT_AUDIENCE=intro-builder-agent
AGENT_JWT_REPLAY_TTL_SECONDS=180

# Required for protected /v1/* routes. Must match the Web app secret.
AGENT_JWT_SECRET=

# OpenAI-compatible chat completions provider for Phase 1 rich-text polish.
# Example base URL: https://api.openai.com/v1 or a compatible relay /v1.
AGENT_MODEL_BASE_URL=
AGENT_MODEL_API_KEY=
AGENT_MODEL_NAME=
AGENT_MODEL_TIMEOUT_MS=90000

# Optional Langfuse tracing. Disabled unless enabled and both keys are present.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=0.0.0-dev
LANGFUSE_TIMEOUT=5
LANGFUSE_SAMPLE_RATE=1
LANGFUSE_EXPERIMENT_RUN_NAME=
LANGFUSE_AGENT_MESSAGE_DATASET_NAME=
LANGFUSE_DATASET_FETCH_ITEMS_PAGE_SIZE=50

# Optional Langfuse Prompt Management for Agent Mode.
LANGFUSE_PROMPT_MANAGEMENT_ENABLED=false
LANGFUSE_AGENT_MESSAGE_PROMPT_NAME=intro-builder/agent-message
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=300
LANGFUSE_PROMPT_FETCH_TIMEOUT_MS=5000

# Privacy guard: keep false outside local debugging. When false, traces include
# metadata and counts but not raw resume text, user messages, or model output.
LANGFUSE_CAPTURE_RAW_PAYLOADS=false

# Used by Caddy in compose.yaml. Set to the production Agent domain later.
AGENT_SITE_ADDRESS=api.rory-x.me
AGENT_PUBLIC_BASE_PATH=/intro-builder/agent
