# Neon Postgres (auto-injected on Vercel when you add the Neon integration).
# Local Postgres is also supported, e.g. postgres://user@127.0.0.1:5432/intro_builder
DATABASE_URL="postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"

# Optional: direct/unpooled URL for drizzle-kit migrations. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=""

# Optional: runtime TCP pool size for local/Docker Postgres URLs.
DATABASE_POOL_MAX="10"

# Auth.js
AUTH_SECRET=""              # openssl rand -base64 32
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Resend (magic link)
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="login@example.com"

# Vercel Blob (photo upload)
BLOB_READ_WRITE_TOKEN=""

# DeepSeek API (resume import: text structuring)
DEEPSEEK_API_KEY=""

# OCR.space API (resume import: image/scanned-PDF text recognition)
# Free tier: 500 calls/day, 25000/month. Get key at https://ocr.space/ocrapi/freekey
# Falls back to "helloworld" test key if not set (rate-limited)
OCR_SPACE_API_KEY=""

# Agent microservice (new Agent capabilities only).
# Local: http://127.0.0.1:8787
# Production: https://api.rory-x.me/intro-builder/agent
AGENT_BASE_URL="http://127.0.0.1:8787"

# Image generation API (template-studio skill: extract decoration from reference resume).
# Any service that accepts OpenAI-compatible POST /images/edits multipart works:
# gpt-image-2 (BMC relay), doubao seedream (Volcano Ark), qwen-image (DashScope-compat
# proxy), Stable Diffusion edit proxies, etc.
# When ANY of the three required vars is missing, the skill skips decoration extraction
# with a warning — the template still gets created, just without a decorative background.
TEMPLATE_IMAGE_API_BASE_URL=""    # e.g. https://bmc-llm-relay.bluemediagroup.cn/v1
TEMPLATE_IMAGE_API_KEY=""          # Bearer token for the service
TEMPLATE_IMAGE_MODEL=""            # e.g. gpt-image-2 / doubao-seedream-3-0 / wanx-v1
TEMPLATE_IMAGE_SIZE="1024x1536"    # optional, portrait A4-ish default
