# Neon Postgres (auto-injected on Vercel when you add the Neon integration).
# Local Postgres is also supported, e.g. postgres://user@127.0.0.1:5432/intro_builder
DATABASE_URL="postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"

# Optional: direct/unpooled URL for drizzle-kit migrations. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=""

# Optional: runtime TCP pool size for local/Docker Postgres URLs.
DATABASE_POOL_MAX="10"

# Auth.js
AUTH_SECRET=""              # openssl rand -base64 32
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Resend (magic link)
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="login@example.com"

# Vercel Blob (photo upload)
BLOB_READ_WRITE_TOKEN=""

# DeepSeek API (resume import: text structuring)
DEEPSEEK_API_KEY=""

# OCR.space API (resume import: image/scanned-PDF text recognition)
# Free tier: 500 calls/day, 25000/month. Get key at https://ocr.space/ocrapi/freekey
# Falls back to "helloworld" test key if not set (rate-limited)
OCR_SPACE_API_KEY=""
